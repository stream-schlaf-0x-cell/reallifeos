# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3100

# ─── Dify AI Configuration ────────────────────────────────────────────────────
# Your Dify Workflow API endpoint.
# For cloud Dify: https://api.dify.ai/v1/workflows/run
# For self-hosted: http://your-dify-host/v1/workflows/run
DIFY_API_URL=https://api.dify.ai/v1/workflows/run

# Your Dify API key (Bearer token). Get this from Dify > Settings > API Access.
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Timeout for Dify requests (ms). Dify workflows can take a while.
REQUEST_TIMEOUT=120000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or '*' for any.
# Set to your React app's URL in production.
CORS_ORIGIN=*

# ─── Data Volume ──────────────────────────────────────────────────────────────
# Absolute path inside the container where generated JSON files are written.
# In Docker, this maps to a host directory via docker-compose.yml volumes.
DATA_DIR=/app/data
